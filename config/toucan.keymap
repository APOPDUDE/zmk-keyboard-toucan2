#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define NUM   2
#define SYM   3
#define FUN   4
#define MEDIA 5
#define MOUSE 6

// key positions: left hand, right hand, thumbs
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Left";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Right";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Thumbs: Esc/NUM  Space/NAV  F18 (VoiceInk, hold to talk) | Enter/SYM  Bksp/FUN  Del/MEDIA
        base {
            display-name = "BASE";
            bindings = <
&none &kp Q          &kp W          &kp E          &kp R           &kp T      &kp Y &kp U           &kp I          &kp O          &kp P            &none
&none &hml LCTRL A   &hml LALT S    &hml LGUI D    &hml LSHFT F    &kp G      &kp H &hmr RSHFT J    &hmr RGUI K    &hmr RALT L    &hmr RCTRL SQT   &none
&none &kp Z          &kp X          &kp C          &kp V           &kp B      &kp N &kp M           &kp COMMA      &kp DOT        &kp FSLH         &none
                     &lt NUM ESC    &lt NAV SPACE  &kp F18         &lt SYM RET    &lt FUN BSPC    &lt MEDIA DEL
            >;
        };

        // hold Space: right hand navigates; Back/Fwd = Cmd+[ ], Space<-/-> = Ctrl+arrows, Mission Control = Ctrl+Up
        nav {
            display-name = "NAV";
            bindings = <
&none &none      &none     &none     &none      &none      &kp LG(LBKT) &kp LC(LEFT) &kp LC(RIGHT) &kp LG(RBKT) &kp LC(UP)    &none
&none &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none      &kp LEFT     &kp DOWN     &kp UP        &kp RIGHT    &kp TAB       &none
&none &none      &none     &none     &none      &none      &kp LG(Z)    &kp LG(X)    &kp LG(C)     &kp LG(V)    &kp LG(LS(Z)) &none
                           &trans    &trans     &trans     &kp RET      &kp BSPC     &kp DEL
            >;
        };

        // hold Esc: numpad on the right hand, $ and % on the left
        num {
            display-name = "NUM";
            bindings = <
&none &none      &none     &kp DLLR  &kp PRCNT  &none      &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp MINUS  &none
&none &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none      &kp FSLH   &kp N4  &kp N5  &kp N6  &kp PLUS   &none
&none &none      &none     &none     &none      &none      &kp COMMA  &kp N1  &kp N2  &kp N3  &kp DOT    &none
                           &trans    &trans     &trans     &kp N0     &kp BSPC &kp RET
            >;
        };

        // hold Enter: symbols on the left hand; hold J (Shift) for _ + { } : ~ |
        sym {
            display-name = "SYM";
            bindings = <
&none &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &none  &none      &none     &none     &none      &none
&none &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR     &none  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &none
&none &kp GRAVE  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT     &none  &none      &none     &none     &none      &none
                            &kp SEMI   &kp BSLH   &trans       &trans &trans     &trans
            >;
        };

        // hold Bksp: F-keys, screenshot (Cmd+Shift+4), lock screen (Ctrl+Cmd+Q)
        fun {
            display-name = "FUN";
            bindings = <
&none &kp F12  &kp F7  &kp F8  &kp F9  &kp LG(LS(N4))    &none  &none      &none     &none     &none      &none
&none &kp F11  &kp F4  &kp F5  &kp F6  &kp LC(LG(Q))     &none  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &none
&none &kp F10  &kp F1  &kp F2  &kp F3  &none             &none  &none      &none     &none     &none      &none
                       &trans  &trans  &trans            &trans &trans     &trans
            >;
        };

        // hold Del: Bluetooth devices, media, brightness; bottom row 4th key unlocks ZMK Studio
        media {
            display-name = "MEDIA";
            bindings = <
&none &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_CLR    &none  &none  &none  &none  &none  &none
&none &kp C_PREV     &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT      &kp C_PP      &none  &none  &none  &none  &none  &none
&none &kp C_BRI_DN   &kp C_BRI_UP    &kp C_MUTE      &studio_unlock  &none         &none  &none  &none  &none  &none  &none
                                     &trans          &trans          &trans        &trans &trans &trans
            >;
        };

        // on while a finger is on the trackpad: thumbs click; VoiceInk key keeps working
        mouse {
            display-name = "MOUSE";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                     &mkp RCLK &mkp LCLK &trans    &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
