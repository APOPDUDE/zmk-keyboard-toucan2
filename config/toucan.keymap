#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/input/input-event-codes.h>

#define BASE  0
#define NAV   1
#define NUM   2
#define MEDIA 3
#define MOUSE 4   // boards/shields/toucan/toucan.dtsi turns it on with &mo 4 while a finger is on the trackpad
#define SWIPE 5   // on while Bksp is held: no keys of its own, only two-finger swipes as gestures (toucan.dtsi)

// key positions: left hand, right hand, thumbs
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Left";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Right";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        // middle left thumb: hold = NAV, tap = one-shot Shift (the next letter is a capital); a letter pressed with it
        // and both released inside the 200 ms is a capital too
        nav_shift: nav_or_sticky_shift {
            compatible = "zmk,behavior-hold-tap";
            display-name = "NAV / Shift";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&sk>;
        };
        // inner left thumb: tap = Space, hold = Cmd after 200 ms (tap-preferred, as Space/NAV was, so fast typing never
        // fires Cmd); tap then hold repeats Space
        cmd_space: cmd_or_space {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Cmd / Space";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // inner right thumb: Bksp, held down it repeats as before, and while held two-finger swipes are the Mac
        // gestures (SWIPE on with it)
        bksp_swipe: bksp_swipe {
            compatible = "zmk,behavior-macro";
            display-name = "Bksp / Swipe";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo SWIPE &kp BSPC>
                , <&macro_pause_for_release>
                , <&macro_release &kp BSPC &mo SWIPE>
                ;
        };
        // a finger landing on the trackpad while Bksp is held lets Bksp go, so the swipe does not delete text
        bksp_up: bksp_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_release &kp BSPC>;
        };
    };

    bksp_off_processor: bksp_off_processor {
        compatible = "zmk,input-processor-behaviors";
        #input-processor-cells = <0>;
        codes = <INPUT_BTN_TOUCH>;
        bindings = <&bksp_up>;
    };

    keymap {
        compatible = "zmk,keymap";

        // Each layer's keys sit on the same hand as the thumb that holds it, so one hand does it alone
        // (NAV on the left, the right hand stays on the trackpad); the other hand's home row holds the modifiers.
        // Thumbs: Esc/MEDIA  Shift/NAV (tap = one-shot Shift)  Space/Cmd | Bksp (repeats when held; held, two-finger swipes
        // are the gestures)  F18 (VoiceInk, hold to talk)  Enter/NUM
        // (Space and Bksp on the two innermost thumbs, out of the way of the letters)
        base {
            display-name = "BASE";
            bindings = <
&none &kp Q          &kp W          &kp E          &kp R           &kp T      &kp Y &kp U           &kp I          &kp O          &kp P            &none
&none &hml LCTRL A   &hml LALT S    &hml LGUI D    &hml LSHFT F    &kp G      &kp H &hmr RSHFT J    &hmr RGUI K    &hmr RALT L    &hmr RCTRL SQT   &none
&none &kp Z          &kp X          &kp C          &kp V           &kp B      &kp N &kp M           &kp COMMA      &kp DOT        &kp FSLH         &none
                     &lt MEDIA ESC  &nav_shift NAV LSHFT  &cmd_space LGUI SPACE   &bksp_swipe    &kp F18         &lt NUM RET
            >;
        };

        // hold the middle left thumb: left hand navigates. E S D F arrows, A Tab, Z undo, X redo, C copy, V paste;
        // W/R Back/Fwd = Cmd+[ ], Q/T Space<-/-> = Ctrl+arrows, G Mission Control = Ctrl+Up, B screenshot = Cmd+Shift+4;
        // right hand U/I: tab left / tab right (Cmd+Shift+[ ], Chrome and most Mac apps); right thumbs Bksp, Del (on F18), Enter
        nav {
            display-name = "NAV";
            bindings = <
&none &kp LC(LEFT)  &kp LG(LBKT)   &kp UP     &kp LG(RBKT)  &kp LC(RIGHT)     &none  &kp LG(LS(LBKT))  &kp LG(LS(RBKT))  &none  &none  &none
&none &kp TAB       &kp LEFT       &kp DOWN   &kp RIGHT     &kp LC(UP)        &none  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &none
&none &kp LG(Z)     &kp LG(LS(Z))  &kp LG(C)  &kp LG(V)     &kp LG(LS(N4))    &none  &none      &none     &none     &none      &none
                                   &trans     &trans        &trans            &kp BSPC     &kp DEL      &kp RET
            >;
        };

        // hold Enter: numpad on the right hand, $ and % on the left; 0, Bksp and Enter on the left thumbs;
        // left bottom row ; = [ ] \ and Q ` (the symbols no other layer has); hold F (Shift) for : + { } | ~, and Shift+digit for ! @ # ^ & ( )
        num {
            display-name = "NUM";
            bindings = <
&none &kp GRAVE  &none     &kp DLLR  &kp PRCNT  &none      &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp MINUS  &none
&none &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none      &kp FSLH   &kp N4  &kp N5  &kp N6  &kp PLUS   &none
&none &kp SEMI   &kp EQUAL &kp LBKT  &kp RBKT   &kp BSLH   &kp COMMA  &kp N1  &kp N2  &kp N3  &kp DOT    &none
                           &kp RET   &kp BSPC   &kp N0     &trans     &trans  &trans
            >;
        };

        // hold Esc (left outer thumb): Bluetooth devices, media, brightness on the left hand, mirrored back from the right
        // so each finger does what it did; bottom row: Z flips the SOTSU monitor (Ctrl+Opt+R, caught by Hammerspoon on
        // the Mac), V unlocks ZMK Studio, B locks the screen (Ctrl+Cmd+Q)
        media {
            display-name = "MEDIA";
            bindings = <
&none  &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_CLR         &none  &none  &none  &none  &none  &none
&none  &kp C_PREV     &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT      &kp C_PP           &none  &none  &none  &none  &none  &none
&none  &kp LC(LA(R))  &kp C_BRI_UP    &kp C_MUTE      &studio_unlock  &kp LC(LG(Q))      &none  &none  &none  &none  &none  &none
                                      &trans          &trans          &trans             &trans &trans &trans
            >;
        };

        // on while a finger is on the trackpad: thumbs click; the VoiceInk key (F18) keeps working
        mouse {
            display-name = "MOUSE";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                     &mkp RCLK &mkp LCLK &mkp RCLK    &mkp LCLK &trans &mkp MCLK
            >;
        };

        // on while Bksp is held (bksp_swipe): every key as on the layer below; it only makes two-finger swipes gestures
        swipe {
            display-name = "SWIPE";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans    &trans &trans &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};

// Bksp held and a finger lands on the trackpad: Bksp lets go (bksp_up). After the dtsi's gestures and scroller overrides;
// process-next, so the touch still reaches the base list's &mo MOUSE.
&trackpad_listener {
    bksp_off {
        layers = <SWIPE>;
        input-processors = <&bksp_off_processor>;
        process-next;
    };
};
