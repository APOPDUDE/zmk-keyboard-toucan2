#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define NUM   2
#define MEDIA 3
#define MOUSE 4   // boards/shields/toucan/toucan.dtsi turns it on with &mo 4 while a finger is on the trackpad

// key positions: left hand, right hand, thumbs
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Left";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Right";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Each layer's keys sit on the same hand as the thumb that holds it, so one hand does it alone
        // (NAV on the left, the right hand stays on the trackpad); the other hand's home row holds the modifiers.
        // Thumbs: F18 (VoiceInk, hold to talk)  Space/NAV  Cmd | Enter/NUM  Bksp (repeats when held)  Esc/MEDIA
        base {
            display-name = "BASE";
            bindings = <
&none &kp Q          &kp W          &kp E          &kp R           &kp T      &kp Y &kp U           &kp I          &kp O          &kp P            &none
&none &hml LCTRL A   &hml LALT S    &hml LGUI D    &hml LSHFT F    &kp G      &kp H &hmr RSHFT J    &hmr RGUI K    &hmr RALT L    &hmr RCTRL SQT   &none
&none &kp Z          &kp X          &kp C          &kp V           &kp B      &kp N &kp M           &kp COMMA      &kp DOT        &kp FSLH         &none
                     &kp F18        &lt NAV SPACE  &kp LGUI        &lt NUM RET    &kp BSPC        &lt MEDIA ESC
            >;
        };

        // hold Space: left hand navigates. E S D F arrows, A Tab, Z undo, X redo, C copy, V paste;
        // W/R Back/Fwd = Cmd+[ ], Q/T Space<-/-> = Ctrl+arrows, G Mission Control = Ctrl+Up, B screenshot = Cmd+Shift+4;
        // right hand U/I: tab left / tab right (Cmd+Shift+[ ], Chrome and most Mac apps)
        nav {
            display-name = "NAV";
            bindings = <
&none &kp LC(LEFT)  &kp LG(LBKT)   &kp UP     &kp LG(RBKT)  &kp LC(RIGHT)     &none  &kp LG(LS(LBKT))  &kp LG(LS(RBKT))  &none  &none  &none
&none &kp TAB       &kp LEFT       &kp DOWN   &kp RIGHT     &kp LC(UP)        &none  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &none
&none &kp LG(Z)     &kp LG(LS(Z))  &kp LG(C)  &kp LG(V)     &kp LG(LS(N4))    &none  &none      &none     &none     &none      &none
                                   &trans     &trans        &trans            &kp RET      &kp BSPC     &kp DEL
            >;
        };

        // hold Enter: numpad on the right hand, $ and % on the left; 0, Bksp and Enter on the left thumbs;
        // left bottom row ; = [ ] \ and Q ` (the symbols no other layer has); hold F (Shift) for : + { } | ~, and Shift+digit for ! @ # ^ & ( )
        num {
            display-name = "NUM";
            bindings = <
&none &kp GRAVE  &none     &kp DLLR  &kp PRCNT  &none      &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp MINUS  &none
&none &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none      &kp FSLH   &kp N4  &kp N5  &kp N6  &kp PLUS   &none
&none &kp SEMI   &kp EQUAL &kp LBKT  &kp RBKT   &kp BSLH   &kp COMMA  &kp N1  &kp N2  &kp N3  &kp DOT    &none
                           &kp RET   &kp BSPC   &kp N0     &trans     &trans  &trans
            >;
        };

        // hold Esc (right thumb): Bluetooth devices, media, brightness on the right hand, mirrored from the left so each
        // finger does what it did; bottom row: M unlocks ZMK Studio, N locks the screen (Ctrl+Cmd+Q)
        media {
            display-name = "MEDIA";
            bindings = <
&none  &none  &none  &none  &none  &none      &bt BT_CLR       &bt BT_SEL 3    &bt BT_SEL 2    &bt BT_SEL 1    &bt BT_SEL 0   &none
&none  &none  &none  &none  &none  &none      &kp C_PP         &kp C_NEXT      &kp C_VOL_UP    &kp C_VOL_DN    &kp C_PREV     &none
&none  &none  &none  &none  &none  &none      &kp LC(LG(Q))    &studio_unlock  &kp C_MUTE      &kp C_BRI_UP    &kp C_BRI_DN   &none
                     &trans &trans &trans     &trans           &trans          &trans
            >;
        };

        // on while a finger is on the trackpad: thumbs click; the VoiceInk key (F18) keeps working
        mouse {
            display-name = "MOUSE";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                     &trans &mkp LCLK &mkp RCLK    &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
